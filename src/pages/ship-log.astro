---
import PageLayout from '../layouts/PageLayout.astro';
import ShipLogGraph from '../components/hidden/ShipLogGraph.svelte';
import DeepGameLoader from '../components/games/DeepGameLoader.svelte';
---

<PageLayout title="Ship Log" description="A record of everything you've discovered">
  <section class="py-16">
    <h1 class="font-display text-4xl font-bold text-nebula-50 md:text-5xl">Ship Log</h1>
    <p class="mt-4 max-w-2xl text-lg text-nebula-400">
      A record of everything you've found. Connections form as you discover more.
    </p>
  </section>

  <!-- Discovery Stats Panel -->
  <section class="pb-8">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5" id="stats-panel">
      <div class="rounded-xl border border-nebula-700/50 bg-nebula-900/50 p-4 text-center">
        <p class="font-mono text-2xl font-bold text-star-blue" id="stat-total">0</p>
        <p class="text-xs text-nebula-500">Discoveries</p>
      </div>
      <div class="rounded-xl border border-nebula-700/50 bg-nebula-900/50 p-4 text-center">
        <p class="font-mono text-2xl font-bold text-star-gold" id="stat-games">0</p>
        <p class="text-xs text-nebula-500">Games</p>
      </div>
      <div class="rounded-xl border border-nebula-700/50 bg-nebula-900/50 p-4 text-center">
        <p class="font-mono text-2xl font-bold text-star-green" id="stat-commands">0</p>
        <p class="text-xs text-nebula-500">Commands</p>
      </div>
      <div class="rounded-xl border border-nebula-700/50 bg-nebula-900/50 p-4 text-center">
        <p class="font-mono text-2xl font-bold text-star-pink" id="stat-visits">0</p>
        <p class="text-xs text-nebula-500">Visits</p>
      </div>
      <div class="rounded-xl border border-nebula-700/50 bg-nebula-900/50 p-4 text-center">
        <p class="font-mono text-2xl font-bold text-star-purple" id="stat-loops">0</p>
        <p class="text-xs text-nebula-500">Loops</p>
      </div>
    </div>
  </section>

  <section class="pb-16">
    <ShipLogGraph client:idle />
  </section>

  <section class="pb-16">
    <DeepGameLoader client:idle />
  </section>
</PageLayout>

<script>
  function updateStats() {
    try {
      const raw = localStorage.getItem('observatory:state');
      if (!raw) return;
      const state = JSON.parse(raw);

      const set = (id: string, val: number | string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = String(val);
      };

      set('stat-total', state.discoveries?.length ?? 0);
      set('stat-games', state.gamesCompleted?.length ?? 0);
      set('stat-commands', state.terminalCommands?.length ?? 0);
      set('stat-visits', state.visitCount ?? 0);
      set('stat-loops', state.loopCount ?? 0);
    } catch {
      // ignore
    }
  }

  updateStats();
  window.addEventListener('observatory:discovery', updateStats);
  window.addEventListener('observatory:state-change', updateStats);
</script>
