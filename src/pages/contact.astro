---
import PageLayout from '../layouts/PageLayout.astro';
import DiscoveryReveal from '../components/hidden/DiscoveryReveal.svelte';
---

<PageLayout title="Contact" description="Get in touch. I'd love to hear from you">
  <section class="py-16">
    <h1 class="font-display text-4xl font-bold text-nebula-50 md:text-5xl">Contact</h1>
    <p class="mt-4 max-w-2xl text-lg text-nebula-400">
      Got a question, idea, or just want to say hello? I'd love to hear from you.
    </p>
  </section>

  <div class="grid gap-12 pb-16 md:grid-cols-2">
    <!-- Contact Form -->
    <!--
      TODO(owner): wire this form to a real submission endpoint. Options:
        - A Cloudflare Pages Function / Worker that emails or stores the message.
        - A hosted form service (Formspree, Web3Forms, etc.) via the `action` URL.
      Until then it degrades gracefully to a mailto: handoff (see inline script below).
    -->
    <form id="contact-form" class="flex flex-col gap-6" action="mailto:hello@example.com" method="POST">
      <div>
        <label for="name" class="mb-2 block text-sm font-medium text-nebula-300">Name</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full rounded-lg border border-nebula-700 bg-nebula-900 px-4 py-3 text-sm text-nebula-100 placeholder-nebula-500 transition-colors focus:border-star-blue focus:outline-none"
          placeholder="Your name"
        />
      </div>
      <div>
        <label for="email" class="mb-2 block text-sm font-medium text-nebula-300">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full rounded-lg border border-nebula-700 bg-nebula-900 px-4 py-3 text-sm text-nebula-100 placeholder-nebula-500 transition-colors focus:border-star-blue focus:outline-none"
          placeholder="you@example.com"
        />
      </div>
      <div>
        <label for="message" class="mb-2 block text-sm font-medium text-nebula-300">Message</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          class="w-full rounded-lg border border-nebula-700 bg-nebula-900 px-4 py-3 text-sm text-nebula-100 placeholder-nebula-500 transition-colors focus:border-star-blue focus:outline-none"
          placeholder="What's on your mind?"
        ></textarea>
      </div>
      <button
        type="submit"
        class="self-start rounded-lg bg-star-blue/10 px-8 py-3 text-sm font-medium text-star-blue transition-colors hover:bg-star-blue/20"
      >
        Send Message
      </button>
    </form>

    <!-- Links -->
    <div class="flex flex-col gap-6">
      <div class="rounded-xl border border-nebula-700/50 bg-nebula-900/50 p-6">
        <!-- TODO(owner): replace placeholder social URLs and the email below with real values. -->
        <h2 class="mb-4 font-display text-lg font-semibold text-nebula-100">Find Me Online</h2>
        <ul class="flex flex-col gap-3">
          <li>
            <a href="https://github.com" class="text-sm text-nebula-400 transition-colors hover:text-star-blue" target="_blank" rel="noopener noreferrer">
              GitHub
            </a>
          </li>
          <li>
            <a href="https://twitter.com" class="text-sm text-nebula-400 transition-colors hover:text-star-blue" target="_blank" rel="noopener noreferrer">
              Twitter / X
            </a>
          </li>
          <li>
            <a href="https://linkedin.com" class="text-sm text-nebula-400 transition-colors hover:text-star-blue" target="_blank" rel="noopener noreferrer">
              LinkedIn
            </a>
          </li>
        </ul>
      </div>

      <div class="rounded-xl border border-nebula-700/50 bg-nebula-900/50 p-6">
        <h2 class="mb-4 font-display text-lg font-semibold text-nebula-100">Email</h2>
        <a href="mailto:hello@example.com" class="text-sm text-star-blue transition-colors hover:text-star-blue/80">
          hello@example.com
        </a>
      </div>
    </div>
  </div>

  <script>
    // Graceful fallback while no server endpoint exists: compose a mailto: draft
    // from the form fields so a submission is never silently discarded.
    // TODO(owner): replace with a real endpoint and remove this handler.
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') ?? '');
      const email = String(data.get('email') ?? '');
      const message = String(data.get('message') ?? '');
      const subject = encodeURIComponent(`Message from ${name || 'a visitor'}`);
      const body = encodeURIComponent(`${message}\n\n— ${name} (${email})`);
      // TODO(owner): set the real contact address here.
      window.location.href = `mailto:hello@example.com?subject=${subject}&body=${body}`;
    });
  </script>

  <!-- Personal note for deep explorers -->
  <DiscoveryReveal client:idle discoveryId="terminal:observer">
    <section class="max-w-3xl pb-16">
      <div class="rounded-lg border border-star-green/30 bg-star-green/5 p-4">
        <p class="text-sm text-star-green/70">
          You found the observer log. You're one of the few who look under the surface.
          If you want to talk about hidden layers, interactive experiments, or creative
          code, just mention "the observatory" in your message. I'll know what you mean.
        </p>
      </div>
    </section>
  </DiscoveryReveal>
</PageLayout>
